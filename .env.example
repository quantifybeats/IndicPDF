# Copy to .env and fill in. The API and the RQ worker MUST share the same
# INDICPDF_MASTER_KEY — they are separate processes, and AES-GCM decryption
# fails (InvalidTag) if their keys differ.

# Base64-encoded 32-byte AES-256 key. Generate with:
#   python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
INDICPDF_MASTER_KEY=

# Single-process dev/test ONLY. Lets SecurityManager use a random ephemeral key
# when INDICPDF_MASTER_KEY is unset. Do NOT set this in any multi-process or
# production deployment — cross-process decryption will fail.
# INDICPDF_ALLOW_EPHEMERAL_KEY=1

# Application API key (currently not enforced on routes — see QA_REPORT_v2 F5).
INDICPDF_API_KEY=

# Redis connection used by the API and the worker.
REDIS_URL=redis://localhost:6379
